---
interface Props {
  socialLinks: { icon: string; url: string }[];
  whatsappUrl: string;
}

const { socialLinks, whatsappUrl } = Astro.props;
---

<div class="flex flex-col items-center md:items-start" data-aos="fade-up" data-aos-delay="300">
  <h4 class="text-slate-900 font-bold mb-10 text-[10px] uppercase tracking-[0.4em] flex items-center gap-3">
    <span class="w-1 h-1 bg-amber-500 rounded-full"></span> Redes
  </h4>
  <div class="flex gap-4 mb-10">
    {socialLinks.filter(social => social.url).map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-400 transition-all duration-500 hover:bg-white hover:border-amber-300 hover:text-amber-600 hover:-translate-y-1 hover:shadow-lg hover:shadow-amber-500/10"
        aria-label={`Visitar ${social.icon} en redes sociales`}
      >
        <i class={`fab fa-${social.icon} text-sm`}></i>
      </a>
    ))}
    {whatsappUrl && (
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-400 transition-all duration-500 hover:bg-white hover:border-amber-300 hover:text-amber-600 hover:-translate-y-1 hover:shadow-lg hover:shadow-amber-500/10"
        aria-label="Contactar por WhatsApp"
      >
        <i class="fab fa-whatsapp text-sm"></i>
      </a>
    )}
  </div>
  <a
    href="#contacto"
    class="group relative overflow-hidden bg-slate-900 text-white font-bold px-8 py-4 rounded-2xl text-[11px] tracking-[0.2em] transition-all hover:shadow-2xl hover:shadow-amber-500/20 active:scale-95 w-full text-center"
  >
    <span class="relative z-10 uppercase">Solicitar Cita</span>
    <div class="absolute inset-0 bg-linear-to-r from-amber-500 to-amber-600 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
  </a>
</div>