---
import { company } from "../../data/company";
import FooterLogo from "./footer/FooterLogo.astro";
import FooterMenu from "./footer/FooterMenu.astro";
import FooterContact from "./footer/FooterContact.astro";
import FooterSocial from "./footer/FooterSocial.astro";

interface Props {
  logoSrc?: string;
  logoAlt?: string;
  title?: string;
  description?: string;
  menuItems?: { label: string; href: string }[];
  address?: { street: string; city: string };
  phone?: string;
  email?: string;
  socialLinks?: { icon: string; url: string }[];
  whatsappUrl?: string;
  privacyUrl?: string;
  termsUrl?: string;
}

const {
  logoSrc = "/logos/logo-largo.png",
  logoAlt = "Logo DHARMA CLINIC",
  title = `${company.name} - ${company.tagline}`,
  description = "Restaurando tu vitalidad desde la raíz con ciencia epigenética y calidez humana.",
  menuItems = [
    { label: "Inicio", href: "/" },
    { label: "Politica de privacidad", href: "/legales/politica-de-privacidad"},
    { label: "Términos y condiciones", href: "/legales/terminos-y-condiciones" },
  ],
  address = company.address || { street: "Dirección no disponible", city: "Ayacucho" },
  phone = company.contact?.phone || "Teléfono no disponible",
  email = company.contact?.email || "Email no disponible",
  socialLinks = [
    { icon: "facebook-f", url: company.social?.facebook || "" },
    { icon: "twitter", url: company.social?.twitter || "" },
    { icon: "instagram", url: company.social?.instagram || "" },
    { icon: "tiktok", url: company.social?.tiktok || "" },
    { icon: "youtube", url: company.social?.youtube || "" },
    { icon: "linkedin-in", url: company.social?.linkedin || "" },
  ],
  whatsappUrl = company.contact?.linkWhatsapp || "",
  privacyUrl = "/legales/politica-de-privacidad",
  termsUrl = "/legales/terminos-y-condiciones",
} = Astro.props;
---

<footer class="bg-white pt-20 md:pt-28 pb-10 border-t border-slate-100 relative overflow-hidden" data-aos="fade-up">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-px bg-linear-to-r from-transparent via-amber-200 to-transparent"></div>

  <div class="max-w-350 mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-4 lg:mb-24">
      <FooterLogo logoSrc={logoSrc} logoAlt={logoAlt} title={title} description={description} />
      <FooterMenu menuItems={menuItems} />
      <FooterContact address={address} phone={phone} email={email} />
      <FooterSocial socialLinks={socialLinks} whatsappUrl={whatsappUrl} />
    </div>

    <div class="pt-10 border-t border-slate-50 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8 text-center md:text-left">
        <p class="text-slate-400 text-[10px] uppercase tracking-widest font-medium">
          &copy; {new Date().getFullYear()} <span class="text-slate-900">Dharma Clinic</span>
        </p>
        <span class="hidden md:block w-px h-3 bg-slate-200"></span>
        <p class="text-slate-400 text-[10px] uppercase tracking-[0.2em]">
          Diseñado y Desarrollado por Jhon QP
        </p>
      </div>
      
      <nav class="flex items-center gap-8" role="navigation" aria-label="Enlaces legales">
        <a href={privacyUrl} class="text-slate-400 text-[10px] uppercase font-bold hover:text-amber-600 transition-colors tracking-[0.2em]">Privacidad</a>
        <a href={termsUrl} class="text-slate-400 text-[10px] uppercase font-bold hover:text-amber-600 transition-colors tracking-[0.2em]">Términos</a>
      </nav>
    </div>
  </div>

  </footer>

  <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "name": "Dharma Clinic",
  "alternateName": "Dharma Medicina Bioregenerativa",
  "description": description,
  "url": "https://dharma-clinic.com", 
  "logo": logoSrc,
  "image": logoSrc,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": address.street,
    "addressLocality": address.city,
    "addressRegion": "Ayacucho",
    "postalCode": "05001",
    "addressCountry": "PE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -13.1605, // Coordenadas aproximadas de Ayacucho
    "longitude": -74.2257
  },
  "telephone": phone,
  "email": email,
  "priceRange": "S/.",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "20:00"
    }
  ],
  "medicalSpecialty": [
    "Regenerative Medicine",
    "Medical Ozone Therapy",
    "Stem Cell Therapy"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": phone,
    "contactType": "customer service",
    "availableLanguage": "Spanish"
  },
  "sameAs": socialLinks.filter(s => s.url).map(s => s.url)
})} />
