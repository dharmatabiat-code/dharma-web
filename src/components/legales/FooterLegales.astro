---
import { company } from "../../data/company";
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t border-gray-200 py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
      
      <!-- Column 1: Logo & Info -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <div class="flex items-center gap-3">
          <div class="bg-white p-3 rounded-3xl inline-block">
            <img src="/logos/logo-largo.png" alt="Logo Dharma" class="h-20 object-contain">
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center md:text-left">
          {company.name} - {company.tagline}
        </p>
        <p class="text-xs text-gray-500 text-center md:text-left">
          {company.address.city}, {company.address.state}, {company.address.country}
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Enlaces</h3>
        <div class="flex flex-col gap-2 text-center md:text-left">
          <a href="/" class="text-sm text-gray-500 hover:text-amber-500 transition-colors">
            Inicio
          </a>
          <a href="/#servicios" class="text-sm text-gray-500 hover:text-amber-500 transition-colors">
            Servicios
          </a>
          <a href="/#beneficios" class="text-sm text-gray-500 hover:text-amber-500 transition-colors">
            Beneficios
          </a>
          <a href="/#contacto" class="text-sm text-gray-500 hover:text-amber-500 transition-colors">
            Contacto
          </a>
        </div>
      </div>

      <!-- Column 3: Legal -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Legal</h3>
        <div class="flex flex-col gap-2 text-center md:text-left">
          <a href="/legales/terminos-y-condiciones" class="text-sm text-gray-500 hover:text-amber-500 transition-colors font-medium">
            Términos y Condiciones
          </a>
          <a href="/legales/politica-de-privacidad" class="text-sm text-gray-500 hover:text-amber-500 transition-colors font-medium">
            Política de Privacidad
          </a>
        </div>
      </div>

    </div>

    <!-- Contact Info -->
    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-6 py-6 border-t border-b border-gray-200 mb-6">
      <a 
        href={`tel:${company.contact.phone}`} 
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-amber-500 transition-colors"
      >
        <i class="fas fa-phone w-4 h-4"></i>
        <span class="hidden sm:inline">{company.contact.phone}</span>
        <span class="sm:hidden">Llamar</span>
      </a>
      <span class="hidden md:inline text-gray-300">|</span>
      <a 
        href={`https://wa.me/${company.contact.whatsapp.replace(/\D/g,'')}`}
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-amber-500 transition-colors"
      >
        <i class="fab fa-whatsapp text-lg"></i>
        <span>WhatsApp</span>
      </a>
      <span class="hidden md:inline text-gray-300">|</span>
      <a 
        href={`mailto:${company.contact.email}`} 
        class="flex items-center gap-2 text-xs md:text-sm text-gray-600 hover:text-amber-500 transition-colors"
      >
        <i class="fas fa-envelope w-4 h-4"></i>
        <span class="hidden lg:inline">{company.contact.email}</span>
        <span class="lg:hidden">Email</span>
      </a>
    </div>

    <!-- Copyright & Address -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <p class="text-xs text-gray-500">
        © {currentYear} {company.name}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-gray-400 flex items-center gap-1">
        <i class="fas fa-map-marker-alt w-3 h-3"></i>
        <span>{company.address.street}, {company.address.colony}</span>
      </p>
    </div>

  </div>
</footer>

