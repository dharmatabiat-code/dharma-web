---
// Header.astro
import { company } from "../data/company";
import NavDesktop from "./header/NavDesktop.astro";
import NavMobile from "./header/NavMobile.astro";

export interface Props {
  navItems?: { label: string; href: string }[];
  socialLinks?: { icon: string; url: string }[];
}

const {
  navItems = [
    { label: "Inicio", href: "#inicio" },
    { label: "Acerca", href: "#acerca" },
    { label: "Servicios", href: "#servicios" },
    { label: "Dirección Médica", href: "#direccion-medica" },
    { label: "Beneficios", href: "#beneficios" },
  ],
  socialLinks = [
    { icon: "facebook-f", url: company.social.facebook },
    { icon: "instagram", url: company.social.instagram },
    { icon: "tiktok", url: company.social.tiktok },
    { icon: "youtube", url: company.social.youtube },
    { icon: "linkedin-in", url: company.social.linkedin },
  ],
} = Astro.props;

const navItemsMobile = [...navItems, { label: "Contacto", href: "#contacto" }];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-700 ease-in-out bg-transparent py-6"
  data-aos="fade-down"
  data-aos-duration="800"
  data-aos-once="true" 
>

  <div
    id="header-border"
    class="absolute bottom-0 left-0 right-0 h-px bg-slate-200/0 transition-all duration-500"
  >
  </div>

  <div class="max-w-350 mx-auto px-6 flex items-center justify-between">
    <div class="flex items-center">
      <a href="/" class="flex items-center group" aria-label="Ir a inicio">
        <img
          id="main-logo"
          src="/logos/logo-largo.png"
          class="h-14 md:h-16 w-auto object-contain transition-all duration-500 group-hover:brightness-110"
          alt="Logo DHARMA"
        />
      </a>
    </div>

    <NavDesktop navItems={navItems} />

    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 text-slate-900 focus:outline-none"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <div class="w-7 h-5 flex flex-col justify-between items-end group">
        <span
          id="bar-1"
          class="w-full h-[1.5px] bg-current rounded-full transition-all duration-300"
        ></span>
        <span
          id="bar-2"
          class="w-2/3 h-[1.5px] bg-current rounded-full transition-all duration-300 group-hover:w-full"
        ></span>
        <span
          id="bar-3"
          class="w-full h-[1.5px] bg-current rounded-full transition-all duration-300"
        ></span>
      </div>
    </button>
  </div>
</header>

<NavMobile navItems={navItemsMobile} socialLinks={socialLinks} />

<script>
  import { initHeader } from "../scripts/header.ts";
  initHeader();
</script>
<style>
  #main-header {
    /* Forzamos que estas propiedades siempre sean transicionables */
    transition-property: background-color, padding, backdrop-filter, box-shadow;
    transition-duration: 500ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    will-change: padding, background-color;
  }

  #main-logo {
    transition: height 500ms ease-in-out;
  }
</style>

</div>
