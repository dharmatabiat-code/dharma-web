---
import { Image } from "astro:assets";
import { services } from "../../data/services";

interface Props {
  servicesData?: typeof services;
}

const { servicesData = services } = Astro.props;
---

<section id="servicios" class="py-25 bg-gray-50 overflow-hidden">
  <div class="max-w-350 mx-auto px-5">
    
    <div class="text-center mb-15">
      <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5" data-aos="fade-up">
        <i class="fas fa-hand-holding-medical mr-2"></i> Nuestros Servicios
      </span>
      <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4" data-aos="fade-up" data-aos-delay="100">
        Tratamientos Bioregenerativos
      </h2>
      <div 
        class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto" 
        data-aos="width-expand" 
        data-aos-delay="400"
      ></div>
      <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg font-light" data-aos="fade-up" data-aos-delay="200">
        Ofrecemos una gama completa de tratamientos diseñados para restaurar tu vitalidad desde el nivel celular.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        servicesData.map((service, index) => (
          <div 
            class="service-card group bg-white border border-amber-200/20 rounded-[2.5rem] overflow-hidden flex flex-col shadow-2xl shadow-slate-200/50"
            data-aos="zoom-in" 
            data-aos-delay={index * 150}
            data-aos-duration="800"
          >
            {/* Imagen con Zoom Suave y Overlay */}
            <div class="relative h-48 md:h-60 w-full overflow-hidden">
              <Image
                  src={service.image}
                  alt={service.title}
                  width={600}
                  height={450}
                  class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-110"
                />
              <div class="absolute inset-0 bg-linear-to-t from-amber-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>

            <div class="flex-1 px-6 pb-10 md:px-8 relative flex flex-col items-center text-center">
              {/* Icono Flotante - Ajuste de Diseño */}
              <div class="icon-box relative -translate-y-1/2 w-20 h-20 bg-white shadow-2xl rounded-2xl flex items-center justify-center text-amber-500 z-20 border border-amber-50 transition-all duration-500 group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white">
                <i class={service.icon + " text-3xl"} />
              </div>

              <div class="-mt-6 w-full">
                <h3 class="text-2xl font-bold text-slate-900 mb-4 transition-colors duration-300 group-hover:text-amber-700 tracking-tight">
                  {service.title}
                </h3>
                <p class="text-slate-500 mb-8 text-sm leading-relaxed font-light">
                  {service.description}
                </p>

                {/* Lista de Features con mayor espaciado y legibilidad */}
                <ul class="space-y-4 w-full px-2">
                  {service.features.map((feature) => (
                    <li class="flex items-center gap-3 text-slate-600 text-sm text-left border-b border-slate-50 pb-2 last:border-0">
                      <i class="fas fa-check text-amber-500 text-[10px] shrink-0" />
                      <span class="leading-tight font-medium">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .service-card {
    transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, box-shadow;
  }

  .service-card:hover {
    transform: translateY(-15px);
    box-shadow: 0 35px 60px -15px rgba(217, 119, 6, 0.12);
    border-color: rgba(245, 158, 11, 0.3);
  }

  [data-aos="width-expand"] {
    width: 0;
    transition-property: width;
  }
  [data-aos="width-expand"].aos-animate {
    width: 5rem;
  }

  @media (max-width: 768px) {
    .service-card:hover {
      transform: translateY(-8px);
    }
  }
</style>