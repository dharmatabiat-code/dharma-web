---
import { Image } from "astro:assets";
import { services } from "../../data/services";

interface Props {
  servicesData?: typeof services;
}

const { servicesData = services } = Astro.props;
---

<section id="servicios" class="py-25 bg-gray-100" data-aos="fade-up">
  <div class="max-w-350 mx-auto px-5">
    <div class="text-center mb-15" data-aos="fade-up" data-aos-delay="200">
      <span
        class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
        ><i class="fas fa-hand-holding-medical mr-2"></i> Nuestros Servicios</span
      >
        <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">
        Tratamientos Bioregenerativos
      </h2>
      <div
        class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
      >
      </div>
        <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg font-light">
      Ofrecemos una gama completa de tratamientos diseñados para restaurar
        tu vitalidad desde el nivel celulary juventud
      </p>
    </div>

   <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7.5" data-aos="fade-up" data-aos-delay="400">
      {
        servicesData.map((service, index) => (
          <div class="bg-white border border-amber-200/20 rounded-3xl overflow-hidden transition-all duration-300 hover:border-amber-500 hover:-translate-y-2 hover:shadow-2xl flex flex-col group" data-aos="zoom-in" data-aos-delay={index * 100}>
            <div class="relative h-48 md:h-56 w-full overflow-hidden shrink-0">
              <Image
                  src={service.image}
                  alt={service.title}
                  width={400}
                  height={300}
                  format="webp"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent"></div>
            </div>

            <div class="flex-1 px-6 pb-8 md:px-8 relative flex flex-col items-center text-center">
              <div class="relative -translate-y-1/2 w-16 h-16 bg-white shadow-xl rounded-2xl flex items-center justify-center text-amber-500 z-20 border border-amber-100 shrink-0">
                <i class={service.icon + " text-3xl"} />
              </div>

              <div class="-mt-4 w-full">
                <h3 class="text-xl font-bold text-gray-800 mb-3">
                  {service.title}
                </h3>

                <p class="text-gray-500 mb-6 text-sm leading-relaxed line-clamp-3  font-light">
                  {service.description}
                </p>

                <ul class="space-y-3 w-full max-w-60 mx-auto">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-3 text-gray-600 text-sm text-left">
                      <i class="fas fa-check-circle text-amber-500 text-[10px] mt-1 shrink-0" />
                      <span class="leading-tight">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>