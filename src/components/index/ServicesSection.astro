---
import { Image } from "astro:assets";
import { services } from "../../data/services";

interface Props {
  servicesData?: typeof services;
}

const { servicesData = services } = Astro.props;
---

<section id="servicios" class="py-25 bg-gray-100 overflow-hidden">
  <div class="max-w-350 mx-auto px-5">
    <div class="text-center mb-15" data-aos="fade-up">
      <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5">
        <i class="fas fa-hand-holding-medical mr-2"></i> Nuestros Servicios
      </span>
      <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">
        Tratamientos Bioregenerativos
      </h2>
      <div class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"></div>
      <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg font-light">
        Ofrecemos una gama completa de tratamientos diseñados para restaurar tu vitalidad desde el nivel celular.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        servicesData.map((service, index) => (
          <div 
            class="service-card group bg-white border border-amber-200/20 rounded-3xl overflow-hidden flex flex-col"
            data-aos="fade-up" 
            data-aos-delay={index * 100}
          >
            {/* Imagen con Zoom suave */}
            <div class="relative h-48 md:h-56 w-full overflow-hidden">
              <Image
                  src={service.image}
                  alt={service.title}
                  width={400}
                  height={300}
                  format="webp"
                  class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-110"
                />
              <div class="absolute inset-0 bg-linear-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>

            <div class="flex-1 px-6 pb-8 md:px-8 relative flex flex-col items-center text-center">
              {/* Icono con elevación */}
              <div class="icon-box relative -translate-y-1/2 w-16 h-16 bg-white shadow-xl rounded-2xl flex items-center justify-center text-amber-500 z-20 border border-amber-100 transition-all duration-500 group-hover:shadow-amber-200/50 group-hover:scale-110">
                <i class={service.icon + " text-3xl"} />
              </div>

              <div class="-mt-4 w-full">
                <h3 class="text-xl font-bold text-gray-800 mb-3 transition-colors duration-300 group-hover:text-amber-700">
                  {service.title}
                </h3>
                <p class="text-gray-500 mb-6 text-sm leading-relaxed line-clamp-3 font-light">
                  {service.description}
                </p>

                <ul class="space-y-3 w-full max-w-60 mx-auto opacity-80 group-hover:opacity-100 transition-opacity duration-500">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-3 text-gray-600 text-sm text-left">
                      <i class="fas fa-check-circle text-amber-500 text-[10px] mt-1 shrink-0" />
                      <span class="leading-tight">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .service-card {
    /* Transición ultra suave usando cubic-bezier */
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), 
                box-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1), 
                border-color 0.4s ease;
    will-change: transform, box-shadow;
  }

  .service-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 50px -12px rgba(217, 119, 6, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
  }

  /* Optimización para móviles: reducir el salto */
  @media (max-width: 768px) {
    .service-card:hover {
      transform: translateY(-5px);
    }
  }
</style>