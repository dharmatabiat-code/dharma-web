---
import { Image } from "astro:assets";
interface Props {
  backgroundImage?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  backgroundImage = "/fondo.jpg",
  title = "Medicina Bioregenerativa e integrativa",
  subtitle = "Restaurando tu salud desde la raíz, con tecnología de vanguardia y un enfoque integral",
  ctaText = "Descubre Nuestros Tratamientos",
  ctaHref = "#servicios",
} = Astro.props;
---

<section
  id="inicio"
  class="min-h-[calc(100vh-80px)] md:min-h-screen flex items-center justify-center relative bg-linear-to-br from-gray-50 via-white to-amber-50 overflow-hidden pt-20 md:pt-20"
>
  <div class="absolute inset-0 z-0">
    <Image
      src={backgroundImage}
      alt="Laboratorio Bioregenerativo"
      width={1920}
      height={1080}
      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 100vw, 1920px"
      format="webp"
      quality={80}
      priority
      class="w-full h-full object-cover opacity-90"
    />
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_80%,rgba(212,165,42,0.15)_0%,transparent_50%),radial-gradient(ellipse_at_80%_20%,rgba(212,165,42,0.1)_0%,transparent_50%),radial-gradient(ellipse_at_50%_50%,rgba(212,165,42,0.05)_0%,transparent_70%)]"
  >
  </div>
  <div class="absolute inset-0 bg-pattern"></div>
  <div class="relative z-10 text-center px-4 md:px-5 animate-fade-in-up" data-aos="fade-up">
    <h1 class="text-2xl md:text-4xl font-light text-gray-800 mb-4 md:mb-5 tracking-wide md:tracking-wider">
      <i class="fas fa-dna text-amber-400 mr-1.5 md:mr-2.5"></i> <span class="md:hidden font-serif">{title}</span>
      <span class="hidden md:inline font-serif">{title}</span>
    </h1>
    <p class="text-gray-600 max-w-xl mx-auto mb-8 md:mb-10 text-base md:text-lg leading-relaxed font-light">
      {subtitle}
    </p>
    <div class="mb-12 md:mb-15">
      <a
        href={ctaHref}
        class="bg-linear-to-r from-amber-500 to-amber-600 text-white font-semibold px-6 py-3 md:px-8 md:py-4 rounded-full transition-all duration-300 hover:from-amber-400 hover:to-amber-500 hover:-translate-y-0.5 hover:shadow-xl inline-flex items-center gap-2 text-sm md:text-base"
      >
        <i class="fas fa-arrow-right"></i>
        <span>{ctaText}</span>
      </a>
    </div>
  </div>
  <div
    class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 animate-bounce-custom"
  >
    <span class="text-2xl md:text-3xl text-amber-400"
      ><i class="fas fa-chevron-down"></i></span
    >
  </div>
</section>