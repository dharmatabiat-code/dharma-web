---
interface Props {
  stats?: { icon: string; value: string; label: string; detail: string }[];
}

const {
  stats = [
    { icon: 'fa-globe-americas', value: '5+', label: 'Países de Formación', detail: 'Rusia, España, EE.UU, Colombia y Argentina' },
    { icon: 'fa-user-md', value: '20+', label: 'Años de Experiencia', detail: 'Médico Cirujano (Rusia 2002)' },
    { icon: 'fa-certificate', value: '12+', label: 'Certificaciones Int.', detail: 'Medicina Regenerativa y Epigenética' },
    { icon: 'fa-microscope', value: '100%', label: 'Enfoque Científico', detail: 'Basado en Medicina de Vanguardia' },
  ],
} = Astro.props;
---

<section class="py-16 md:py-24 bg-linear-to-br from-amber-700 via-amber-600 to-amber-800 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" data-aos="fade-in" data-aos-duration="2000">

  </div>

  <div class="max-w-350 mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {stats.map((stat, index) => (
        <div 
          class="group relative p-6 md:p-8 rounded-2xl transition-all duration-500 hover:bg-white/10 hover:backdrop-blur-md border border-white/5 hover:border-white/20 flex flex-col items-center text-center sm:items-start sm:text-left"
          data-aos="zoom-in" 
          data-aos-delay={index * 150} 
          data-aos-duration="800"
        >
          <div class="text-3xl md:text-4xl text-amber-200 mb-4 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1">
            <i class={`fas ${stat.icon}`}></i>
          </div>

          <div class="text-4xl md:text-5xl font-black text-white mb-2 tracking-tight">
            {stat.value}
          </div>

          <div class="text-amber-100/80 font-semibold uppercase tracking-widest text-[10px] md:text-xs">
            {stat.label}
          </div>

          <p class="text-amber-50/50 text-[10px] mt-2 leading-tight opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            {stat.detail}
          </p>

          <div class="absolute bottom-0 left-1/2 sm:left-8 -translate-x-1/2 sm:translate-x-0 w-0 h-1 bg-amber-300 transition-all duration-500 group-hover:w-1/3 rounded-full"></div>
        </div>
      ))}
    </div>
  </div>
</section>