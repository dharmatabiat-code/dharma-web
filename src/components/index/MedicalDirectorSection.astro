---
import { Image } from "astro:assets";

interface Props {
  name?: string;
  title?: string;
  specialty?: string;
  description?: string;
  imageSrc?: string;
  imageAlt?: string;
  certifications?: { icon: string; title: string; description: string }[];
}

const {
  name = "Dra. Amalia Luque Huancapaza",
  title = "Especialista en Epigenética, Medicina y Terapias Integrativas",
  specialty = "Médico Cirujano y Especialista por la Universidad Rusa de la Amistad de los Pueblos",
  description = "La Dra. Luque combina una sólida formación académica con certificaciones internacionales de élite para ofrecer tratamientos que restauran la salud desde el nivel celular.",
  imageSrc = "/images/beneficios/1.jpeg",
  imageAlt = "Dra. Amalia Luque Huancapaza - Directora Médica Dharma",
  certifications = [
    { icon: "fa-dna", title: "Medicina Regenerativa", description: "Certificada por la ISSCA (Miami, EE.UU.) en tratamientos con Células Madre y Regeneración Celular." },
    { icon: "fa-fingerprint", title: "Epigenética Aplicada", description: "Especialista en análisis epigenético capilar y nutrición genómica (Certificación España)." },
    { icon: "fa-leaf", title: "Terapias Integrativas", description: "Experta en Ozonoterapia Médica, Acupuntura y Medicina Ortomolecular." },
    { icon: "fa-stethoscope", title: "Atención Integral", description: "Capacitación continua en Medicina Complementaria por ESSALUD." },
  ],
} = Astro.props;
---

<section id="direccion-medica" class="py-25 bg-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-64 h-64 bg-amber-50 rounded-full blur-3xl opacity-50 -mr-32 -mt-32"></div>

  <div class="max-w-350 mx-auto px-5 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <div class="space-y-8">
        <div>
          <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
            data-aos="fade-up"> 
            <i class="fas fa-microscope mr-2"></i> Dirección Médica
          </span>
          
          <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4" data-aos="fade-up" data-aos-delay="100">
            {name}
          </h2>
          <p class="text-amber-600 font-medium mt-2 tracking-wide uppercase text-sm italic" data-aos="fade-up" data-aos-delay="200">
            {title}
          </p>
        </div>

        <p class="text-slate-600 text-lg leading-relaxed font-light" data-aos="fade-up" data-aos-delay="300">
          {specialty}. {description}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {certifications.map((cert, index) => (
            <div 
              class="p-5 rounded-2xl bg-slate-50 border border-slate-100 transition-colors hover:border-amber-200"
              data-aos="zoom-in"
              data-aos-delay={400 + (index * 100)}
            >
              <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-amber-600 shadow-sm mb-4">
                <i class={`fas ${cert.icon}`}></i>
              </div>
              <h3 class="font-bold text-slate-900 mb-1 text-sm uppercase">{cert.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{cert.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="relative group max-w-md mx-auto lg:ml-auto lg:mr-4" data-aos="fade-left" data-aos-delay="500">
        <div class="absolute -inset-4 bg-amber-100/50 rounded-[3rem] rotate-3 transition-transform group-hover:rotate-1"></div>

        <div class="relative rounded-4xl overflow-hidden shadow-2xl border-8 border-white bg-slate-100 aspect-3/5">
          <Image
            src={imageSrc}
            alt={imageAlt}
            width={891}
            height={768}
            sizes="(max-width: 768px) 100vw, 50vw"
            format="webp"
            quality={80}
            class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>

        <div 
          class="absolute bottom-6 -right-4 bg-slate-900 text-white p-5 rounded-2xl shadow-xl hidden md:block"
          data-aos="fade-up"
          data-aos-delay="800"
          data-aos-anchor="#direccion-medica"
        >
          <p class="text-[10px] uppercase tracking-widest text-amber-400 font-bold mb-1">Registro Profesional</p>
          <p class="text-lg font-bold">CMP 057731</p>
          <p class="text-[10px] text-slate-400">RNE 021516</p>
        </div>
      </div>
    </div>
  </div>
</section>