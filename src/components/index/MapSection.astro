---
import { company } from "../../data/company";

interface Props {
  companyData?: typeof company;
}

const { companyData = company } = Astro.props;

// Concatenamos la dirección para el cuadro informativo
const fullAddress = `${companyData.address.street}, ${companyData.address.city}`;
---

<section class="py-12 bg-slate-50 relative overflow-hidden">
  
  <div 
    class="max-w-350 mx-auto px-2 md:px-5"
    data-aos="zoom-in" 
    data-aos-duration="1000"
  >
    <div class="rounded-[3rem] overflow-hidden shadow-2xl shadow-amber-900/10 border-8 border-white relative group">
      
      <div class="absolute inset-0 pointer-events-none border border-amber-200/20 rounded-[2.5rem] z-10"></div>
      
      <iframe 
        src={companyData.address.mapLink}
        class="w-full h-112.5 grayscale-[0.4] contrast-[1.1] transition-all duration-1000 group-hover:grayscale-0"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Ubicación de ${companyData.name} en ${companyData.address.city}`}>
      </iframe>

      <div 
        class="absolute bottom-8 left-8 bg-white/95 backdrop-blur-md p-6 rounded-3xl shadow-2xl border border-amber-100 hidden lg:block z-20 max-w-xs transition-transform duration-500 group-hover:-translate-y-2"
        data-aos="fade-up"
        data-aos-delay="500"
      >
        <div class="flex items-center gap-4 mb-3">
          <div class="w-10 h-10 bg-linear-to-br from-amber-500 to-amber-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-amber-500/30">
            <i class="fas fa-route text-lg"></i>
          </div>
          <div>
            <span class="block font-black text-slate-900 text-sm tracking-tight uppercase">¿Cómo llegar?</span>
            <span class="block text-[10px] text-amber-600 font-bold uppercase tracking-wider">Ayacucho, Perú</span>
          </div>
        </div>
        
        <p class="text-slate-600 text-xs mb-4 leading-relaxed font-medium">
          {fullAddress}
        </p>

        <a
          href={companyData.address.mapLink}
          target="_blank"
          class="inline-flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-xl text-[10px] font-bold tracking-widest hover:bg-amber-600 transition-colors duration-300"
        >
          ABRIR EN GOOGLE MAPS <i class="fas fa-external-link-alt"></i>
        </a>
      </div>

      <div class="absolute top-4 right-4 bg-amber-500 text-white px-3 py-1 rounded-full text-[10px] font-bold md:hidden z-20 shadow-lg">
        INTERACTIVO
      </div>
    </div>
  </div>
</section>

<style>
  /* Suavizado de carga para el iframe */
  iframe {
    background: #f1f5f9; /* slate-100 */
  }
</style>