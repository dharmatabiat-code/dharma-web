---
import { testimonials } from "../../data/testimonials";

interface Props {
  testimonialsData?: typeof testimonials;
}

const { testimonialsData = testimonials } = Astro.props;
---

<section id="testimonios" class="py-25 bg-linear-to-br from-gray-50 via-white to-amber-50/30 relative overflow-hidden">
  <div class="absolute top-10 left-10 w-40 h-40 bg-amber-400/5 rounded-full blur-3xl animate-pulse"></div>
  <div class="absolute bottom-10 right-10 w-60 h-60 bg-amber-400/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

  <div class="max-w-350 mx-auto px-5 relative z-10">
    
    <div class="text-center mb-16">
      <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5" data-aos="fade-up">
        <i class="fas fa-quote-left mr-2"></i> Testimonios
      </span>

      <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4" data-aos="fade-up" data-aos-delay="100">
        Lo Que Dicen Nuestros Pacientes
      </h2>

      <div class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto" data-aos="width-expand" data-aos-delay="400"></div>
    </div>

    <div class="relative overflow-hidden" data-aos="zoom-in" data-aos-delay="300" data-aos-duration="1000">
      <div class="testimonial-slider flex transition-transform duration-700 ease-in-out">
        {testimonialsData.map((testimonial) => (
          <div class="w-full shrink-0 px-4">
            <div class="bg-white/80 backdrop-blur-md rounded-[2.5rem] p-8 md:p-12 shadow-2xl shadow-amber-900/5 border border-white relative max-w-3xl mx-auto">
              
              <i class="fas fa-quote-right absolute top-8 right-10 text-6xl text-amber-500/10 italic"></i>

              <div class="flex justify-center mb-8">
                <div class="flex gap-1.5 bg-amber-50 px-4 py-2 rounded-full border border-amber-100">
                  {Array.from({ length: testimonial.rating }).map(() => (
                    <i class="fas fa-star text-amber-400 text-sm"></i>
                  ))}
                </div>
              </div>

              <blockquote class="text-center mb-10">
                <p class="text-slate-700 text-xl md:text-2xl leading-relaxed font-serif italic">
                  "{testimonial.comment}"
                </p>
              </blockquote>

              <div class="flex items-center justify-center gap-5 border-t border-slate-100 pt-8">
                <div class="relative">
                  <div class="w-16 h-16 bg-linear-to-br from-amber-400 to-amber-600 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg rotate-3">
                    <i class="fas fa-user -rotate-3"></i>
                  </div>
                 </div>
                
                <div class="text-left">
                  <span class="block text-slate-900 font-black text-xl tracking-tight">
                    {testimonial.name}
                  </span>
                  <span class="inline-flex items-center gap-2 text-amber-600 text-sm font-bold uppercase tracking-widest">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    {testimonial.treatment}
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="flex justify-center items-center gap-4 mt-12">
        {testimonialsData.map((_, index) => (
          <button 
            class="testimonial-dot group relative h-6 flex items-center focus:outline-none"
            aria-label={`Ver testimonio ${index + 1}`}
          >
            <span class="block w-3 h-3 rounded-full bg-slate-200 transition-all duration-500 group-[.active]:bg-amber-500 group-[.active]:w-12 group-[.active]:shadow-lg group-[.active]:shadow-amber-500/30"></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-slider {
    will-change: transform;
    cursor: grab;
  }
  
  .testimonial-slider:active {
    cursor: grabbing;
  }

  /* Animación para la línea decorativa */
  [data-aos="width-expand"] {
    width: 0;
    transition-property: width;
  }
  [data-aos="width-expand"].aos-animate {
    width: 5rem;
  }

  @media (max-width: 768px) {
    .testimonial-slider {
      transition-duration: 500ms;
    }
  }
</style>

<script>
  import "../../scripts/testimonial-slider";
</script>