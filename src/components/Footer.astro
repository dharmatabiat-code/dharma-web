---

---

<footer class="bg-gray-50 pt-15 pb-5 border-t border-amber-200/20">
  <div class="max-w-420 mx-auto px-5">
    <div class="grid grid-cols-4 gap-10 mb-10">
      <div class="footer-brand">
        <div class="flex items-center gap-2.5 mb-4">
          <a href="/" class="flex items-center" aria-label="Ir a inicio">
            <img
              id="main-logo"
              src="/logos/logo-largo.png"
              class="h-24 w-auto object-contain transition-all duration-300"
              alt="Logo DHARMA"
            />
          </a>
        </div>
        <p class="text-gray-500 font-semibold mb-2.5">
          Medicina Bioregenerativa de Vanguardia
        </p>
        <p class="text-gray-500 text-sm leading-relaxed">
          Restaurando tu salud desde la raíz, con tecnología de vanguardia y un
          enfoque integral para tu bienestar.
        </p>
      </div>

      <div class="footer-links">
        <h4 class="text-amber-400 mb-5 text-lg flex items-center gap-2.5">
          <i class="fas fa-link"></i> Enlaces Rápidos
        </h4>
        <ul class="list-none p-0">
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <a
              href="#about"
              class="text-gray-500 no-underline transition-all duration-300 hover:text-amber-400 flex items-center gap-2.5"
              ><i class="fas fa-chevron-right text-xs text-amber-500"></i> Nosotros</a>
          </li>
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <a
              href="#servicios"
              class="text-gray-500 no-underline transition-all duration-300 hover:text-amber-400 flex items-center gap-2.5"
              ><i class="fas fa-chevron-right text-xs text-amber-500"></i> Servicios</a>
          </li>
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <a
              href="#contacto"
              class="text-gray-500 no-underline transition-all duration-300 hover:text-amber-400 flex items-center gap-2.5"
              ><i class="fas fa-chevron-right text-xs text-amber-500"></i> Contacto</a>
          </li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4 class="text-amber-400 mb-5 text-lg flex items-center gap-2.5">
          <i class="fas fa-address-book"></i> Contacto
        </h4>
        <ul class="list-none p-0">
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <i class="fas fa-map-marker-alt text-amber-500 text-sm"></i> Av. Principal
            123, CDMX
          </li>
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <i class="fas fa-phone text-amber-500 text-sm"></i> +52 (55) 1234 5678
          </li>
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <i class="fas fa-envelope text-amber-500 text-sm"></i> info@dharma.com.mx
          </li>
          <li class="mb-3 text-gray-500 flex items-center gap-2.5">
            <i class="fas fa-clock text-amber-500 text-sm"></i> Lun-Sáb: 9:00 - 20:00
          </li>
        </ul>
      </div>

      <div class="footer-social">
        <h4 class="text-amber-400 mb-5 text-lg flex items-center gap-2.5">
          <i class="fas fa-share-alt"></i> Síguenos
        </h4>
        <div class="flex gap-3.75 mb-5">
          <a
            href="#"
            aria-label="Facebook"
            class="w-11 h-11 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400 no-underline transition-all duration-300 border border-amber-400/30 hover:bg-amber-500 hover:text-white hover:-translate-y-0.5 hover:shadow-lg"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href="#"
            aria-label="Instagram"
            class="w-11 h-11 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400 no-underline transition-all duration-300 border border-amber-400/30 hover:bg-amber-500 hover:text-white hover:-translate-y-0.5 hover:shadow-lg"
          >
            <i class="fab fa-instagram"></i>
          </a>
          <a
            href="#"
            aria-label="Twitter"
            class="w-11 h-11 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400 no-underline transition-all duration-300 border border-amber-400/30 hover:bg-amber-500 hover:text-white hover:-translate-y-0.5 hover:shadow-lg"
          >
            <i class="fab fa-twitter"></i>
          </a>
          <a
            href="#"
            aria-label="YouTube"
            class="w-11 h-11 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400 no-underline transition-all duration-300 border border-amber-400/30 hover:bg-amber-500 hover:text-white hover:-translate-y-0.5 hover:shadow-lg"
          >
            <i class="fab fa-youtube"></i>
          </a>
        </div>
        <div class="mt-4">
          <a
            href="#contacto"
            class="bg-linear-to-r from-amber-500 to-amber-600 text-white font-semibold px-5 py-2.5 rounded-full transition-all duration-300 hover:from-amber-400 hover:to-amber-500 hover:-translate-y-0.5 hover:shadow-lg flex items-center justify-center gap-2 text-sm"
          >
            <i class="fas fa-calendar-check"></i>
            <span>Agenda tu consulta</span>
          </a>
        </div>
      </div>
    </div>

    <div class="text-center pt-5 border-t border-black/10">
      <p class="text-gray-500 text-sm">
        &copy; 2024 <strong class="text-amber-400">Dharma</strong> - Medicina Bioregenerativa.
        Todos los derechos reservados.
      </p>
      <div class="mt-2.5 flex justify-center gap-3.75">
        <a
          href="/legales/terminos-y-condiciones"
          class="text-gray-500 no-underline text-sm transition-colors duration-300 hover:text-amber-500"
          >Política de Privacidad</a
        >
        <span class="text-gray-500">|</span>
        <a
          href="/legales/politica-de-privacidad"
          class="text-gray-500 no-underline text-sm transition-colors duration-300 hover:text-amber-500"
          >Términos y Condiciones</a
        >
      </div>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 1024px) {
    .grid-cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .grid-cols-4 {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand,
    .footer-links li,
    .footer-contact li {
      justify-content: center;
    }

    .footer-social > div:first-child {
      justify-content: center;
    }

    .footer-social > div:last-child {
      display: flex;
      justify-content: center;
    }
  }
</style>
