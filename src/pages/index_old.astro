---
import Layout from "../layouts/Layout.astro";
import { company } from "../data/company";
import { services, benefits } from "../data/services";
import { testimonials } from "../data/testimonials";

// Get first 3 testimonials for display
const displayTestimonials = testimonials.slice(0, 3);
---

<Layout>
  <!-- Hero Section -->
  <section
    id="inicio"
    class="min-h-[calc(100vh-80px)] md:min-h-screen flex items-center justify-center relative bg-linear-to-br from-gray-50 via-white to-amber-50 overflow-hidden pt-20 md:pt-20"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/fondo.jpg"
        alt="Laboratorio Bioregenerativo"
        class="w-full h-full object-cover opacity-99 mix-blend-overlay scale-105 animate-slow-zoom"
      />
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_80%,rgba(212,165,42,0.15)_0%,transparent_50%),radial-gradient(ellipse_at_80%_20%,rgba(212,165,42,0.1)_0%,transparent_50%),radial-gradient(ellipse_at_50%_50%,rgba(212,165,42,0.05)_0%,transparent_70%)]"
    >
    </div>
    <div class="absolute inset-0 bg-pattern"></div>
    <div class="relative z-10 text-center px-4 md:px-5 animate-fade-in-up" data-aos="fade-up">
      <h2 class="text-2xl md:text-4xl font-light text-gray-800 mb-4 md:mb-5 tracking-wide md:tracking-wider">
        <i class="fas fa-dna text-amber-400 mr-1.5 md:mr-2.5"></i> <span class="md:hidden font-serif">Medicina Bioregenerativa e integrativa</span>
        <span class="hidden md:inline font-serif">Medicina Bioregenerativa e Integrativa</span>
      </h2>
      <p class="text-gray-600 max-w-xl mx-auto mb-8 md:mb-10 text-base md:text-lg leading-relaxed font-light">
        Restaurando tu salud desde la raíz, con tecnología de vanguardia y un
        enfoque integral
      </p>
      <div class="mb-12 md:mb-15">
        <a
          href="#servicios"
          class="bg-linear-to-r from-amber-500 to-amber-600 text-white font-semibold px-6 py-3 md:px-8 md:py-4 rounded-full transition-all duration-300 hover:from-amber-400 hover:to-amber-500 hover:-translate-y-0.5 hover:shadow-xl inline-flex items-center gap-2 text-sm md:text-base"
        >
          <i class="fas fa-arrow-right"></i>
          <span>Descubre Nuestros Tratamientos</span>
        </a>
      </div>
    </div>
    <div
      class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 animate-bounce-custom"
    >
      <span class="text-2xl md:text-3xl text-amber-400"
        ><i class="fas fa-chevron-down"></i></span
      >
    </div>
  </section>

  
  <!-- About Section -->
 <section id="acerca" class="py-25 bg-white relative overflow-hidden" data-aos="fade-up">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-16" data-aos="fade-up" data-aos-delay="200">
     <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-star mr-2"></i> Sobre Dharma</span>
      <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">Medicina del Futuro, Hoy</h2>
      <div class="h-1 w-20 bg-linear-to-r from-amber-500 to-amber-200 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      
      <div class="relative order-2 lg:order-1" data-aos="fade-up" data-aos-delay="300">
        <div class="absolute -inset-4 bg-slate-100 rounded-[2.5rem] -rotate-2"></div>
        <div class="relative h-125 w-full rounded-4xl overflow-hidden shadow-2xl border border-amber-100 bg-slate-200">
          <img
            src="/MEDIC.jpg"
            alt="Laboratorio Bioregenerativo Dharma"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          />
          <div class="absolute inset-0 bg-linear-to-t from-slate-900/40 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 p-6 bg-white/90 backdrop-blur-md rounded-2xl border border-white/50">
            <p class="text-slate-800 text-sm font-medium italic">
              "Transformamos tu salud optimizando la expresión de tus genes y restaurando tu vitalidad celular."
            </p>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2 space-y-8" data-aos="fade-up" data-aos-delay="300">
        <div class="space-y-6">
          <p class="text-slate-600 text-xl leading-relaxed font-light">
            En <strong class="text-slate-900 font-semibold">Dharma</strong>, no solo tratamos síntomas; reprogramamos tu bienestar. Somos pioneros en <span class="text-amber-600 font-medium">Medicina Bioregenerativa y Epigenética</span>, disciplinas que permiten restaurar tejidos y funciones deterioradas usando los propios recursos de tu organismo.
          </p>
          
          <p class="text-slate-600 text-lg leading-relaxed">
            Bajo la dirección de la Dra. Amalia Luque, aplicamos protocolos de <span class="font-bold text-slate-800">clase mundial</span> (Rusia, EE.UU. y España) que combinan la biotecnología avanzada con terapias integrativas para lograr resultados extraordinarios sin recurrir a procedimientos invasivos.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
          <div class="group flex items-start gap-4" data-aos="zoom-in" data-aos-delay="100">
            <div class="shrink-0 w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 border border-amber-100 transition-colors group-hover:bg-amber-500 group-hover:text-white">
              <i class="fas fa-dna"></i>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wide">Medicina Celular</h4>
              <p class="text-slate-500 text-xs leading-relaxed">Terapias con células madre y factores de crecimiento autólogos.</p>
            </div>
          </div>

          <div class="group flex items-start gap-4" data-aos="zoom-in" data-aos-delay="200">
            <div class="shrink-0 w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 border border-amber-100 transition-colors group-hover:bg-amber-500 group-hover:text-white">
              <i class="fas fa-fingerprint"></i>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wide">Epigenética</h4>
              <p class="text-slate-500 text-xs leading-relaxed">Análisis de factores externos para optimizar tu longevidad.</p>
            </div>
          </div>

          <div class="group flex items-start gap-4" data-aos="zoom-in" data-aos-delay="300">
            <div class="shrink-0 w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 border border-amber-100 transition-colors group-hover:bg-amber-500 group-hover:text-white">
              <i class="fas fa-leaf"></i>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wide">Enfoque Natural</h4>
              <p class="text-slate-500 text-xs leading-relaxed">Tratamientos bio-compatibles potenciados con ozonoterapia.</p>
            </div>
          </div>

          <div class="group flex items-start gap-4" data-aos="zoom-in" data-aos-delay="400">
            <div class="shrink-0 w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 border border-amber-100 transition-colors group-hover:bg-amber-500 group-hover:text-white">
              <i class="fas fa-shield-alt"></i>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wide">No Invasivo</h4>
              <p class="text-slate-500 text-xs leading-relaxed">Recuperación inmediata sin cirugías ni riesgos químicos.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- Services Section -->
  <section id="servicios" class="py-25 bg-gray-100" data-aos="fade-up">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15" data-aos="fade-up" data-aos-delay="200">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-hand-holding-medical mr-2"></i> Nuestros Servicios</span
        >
          <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">
          Tratamientos Bioregenerativos
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
          <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg font-light">
        Ofrecemos una gama completa de tratamientos diseñados para restaurar
          tu vitalidad desde el nivel celulary juventud
        </p>
      </div>

     <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7.5" data-aos="fade-up" data-aos-delay="400">
        {
          services.map((service, index) => (
            <div class="bg-white border border-amber-200/20 rounded-3xl overflow-hidden transition-all duration-300 hover:border-amber-500 hover:-translate-y-2 hover:shadow-2xl flex flex-col group" data-aos="zoom-in" data-aos-delay={index * 100}>
              
              {/* 1. Contenedor de Imagen con altura fija para consistencia */}
              <div class="relative h-48 md:h-56 w-full overflow-hidden shrink-0">
                <img 
                  src={service.image} 
                  alt={service.title} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent"></div>
              </div>

              {/* 2. Cuerpo de la tarjeta */}
              <div class="flex-1 px-6 pb-8 md:px-8 relative flex flex-col items-center text-center">
                
                {/* ICONO: La clave es el -translate-y-1/2 para que siempre esté a la mitad */}
                <div class="relative -translate-y-1/2 w-16 h-16 bg-white shadow-xl rounded-2xl flex items-center justify-center text-amber-500 z-20 border border-amber-100 shrink-0">
                  <i class={service.icon + " text-3xl"} />
                </div>

                {/* Ajuste de margen para compensar el translate del icono */}
                <div class="-mt-4 w-full">
                  <h3 class="text-xl font-bold text-gray-800 mb-3">
                    {service.title}
                  </h3>
                  
                  <p class="text-gray-500 mb-6 text-sm leading-relaxed line-clamp-3  font-light">
                    {service.description}
                  </p>

                  <ul class="space-y-3 w-full max-w-60 mx-auto">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-3 text-gray-600 text-sm text-left">
                        <i class="fas fa-check-circle text-amber-500 text-[10px] mt-1 shrink-0" /> 
                        <span class="leading-tight">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

              </div>
            </div>
          ))
        }
      </div>

    </div>
  </section>

  <!-- Medical Director Section -->
  <section id="direccion-medica" class="py-25 bg-white relative overflow-hidden" data-aos="fade-up">
    <div class="absolute top-0 right-0 w-64 h-64 bg-amber-50 rounded-full blur-3xl opacity-50 -mr-32 -mt-32"></div>

    <div class="max-w-350 mx-auto px-5 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center" data-aos="fade-up" data-aos-delay="200">
        
        <div class="space-y-8">
          <div>
            <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          > <i class="fas fa-microscope mr-2"></i> Dirección Médica
            </span>
            <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">
              Dra. Amalia Luque Huancapaza
            </h2>
            <p class="text-amber-600 font-medium mt-2 tracking-wide uppercase text-sm italic">
              Especialista en Epigenética, Medicina y Terapias Integrativas
            </p>
          </div>

          <p class="text-slate-600 text-lg leading-relaxed font-light">
            Médico Cirujano y Especialista por la <span class="font-semibold text-slate-800">Universidad Rusa de la Amistad de los Pueblos</span>. La Dra. Luque combina una sólida formación académica con certificaciones internacionales de élite para ofrecer tratamientos que restauran la salud desde el nivel celular.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 transition-colors hover:border-amber-200" data-aos="zoom-in" data-aos-delay="100">
              <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-amber-600 shadow-sm mb-4">
                <i class="fas fa-dna"></i>
              </div>
              <h3 class="font-bold text-slate-900 mb-1 text-sm uppercase">Medicina Regenerativa</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Certificada por la <span class="font-bold">ISSCA (Miami, EE.UU.)</span> en tratamientos con Células Madre y Regeneración Celular.</p>
            </div>
            
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 transition-colors hover:border-amber-200" data-aos="zoom-in" data-aos-delay="200">
              <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-amber-600 shadow-sm mb-4">
                <i class="fas fa-fingerprint"></i>
              </div>
              <h3 class="font-bold text-slate-900 mb-1 text-sm uppercase">Epigenética Aplicada</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Especialista en análisis epigenético capilar y nutrición genómica (Certificación España).</p>
            </div>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 transition-colors hover:border-amber-200" data-aos="zoom-in" data-aos-delay="300">
              <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-amber-600 shadow-sm mb-4">
                <i class="fas fa-leaf"></i>
              </div>
              <h3 class="font-bold text-slate-900 mb-1 text-sm uppercase">Terapias Integrativas</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Experta en Ozonoterapia Médica, Acupuntura y Medicina Ortomolecular.</p>
            </div>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 transition-colors hover:border-amber-200" data-aos="zoom-in" data-aos-delay="400">
              <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-amber-600 shadow-sm mb-4">
                <i class="fas fa-stethoscope"></i>
              </div>
              <h3 class="font-bold text-slate-900 mb-1 text-sm uppercase">Atención Integral</h3>
              <p class="text-xs text-slate-500 leading-relaxed">Capacitación continua en Medicina Complementaria por ESSALUD.</p>
            </div>
          </div>

        </div>

        <div class="relative group max-w-md mx-auto lg:ml-auto lg:mr-4">
          <div class="absolute -inset-4 bg-amber-100/50 rounded-[3rem] rotate-3 transition-transform group-hover:rotate-1"></div>
          
          <div class="relative rounded-4xl overflow-hidden shadow-2xl border-8 border-white bg-slate-100 aspect-3/5">
            <img
              src="/images/beneficios/1.jpeg" 
              alt="Dra. Amalia Luque Huancapaza - Directora Médica Dharma"
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <div class="absolute bottom-6 -right-4 bg-slate-900 text-white p-5 rounded-2xl shadow-xl hidden md:block">
            <p class="text-[10px] uppercase tracking-widest text-amber-400 font-bold mb-1">Registro Profesional</p>
            <p class="text-lg font-bold">CMP 057731</p>
            <p class="text-[10px] text-slate-400">RNE 021516</p>
          </div>
        </div>

      </div>
    </div>
  </section>
  

  <!-- Benefits Section -->
  <section id="beneficios" class="py-25 bg-white" data-aos="fade-up">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15" data-aos="fade-up" data-aos-delay="200">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-award mr-2"></i> ¿Por Qué Elegirnos?</span
        >
        <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">
          Beneficios de la Medicina Bioregenerativa
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
      </div>

      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12 max-w-7xl mx-auto" data-aos="fade-up" data-aos-delay="400">
  
        {/* Columna Izquierda: Primeros 3 beneficios */}
        <div class="flex-1 grid grid-cols-1 gap-6 w-full order-2 lg:order-1">
          {benefits.slice(0, 3).map((benefit, index) => (
            <div class="p-6 border-r-[3px] border-amber-500 bg-white shadow-sm hover:shadow-md transition-shadow text-right" data-aos="fade-up" data-aos-delay={index * 100 + 200}>
              <div class="text-5xl font-bold text-amber-500 opacity-20 mb-2">{benefit.number}</div>
              <h3 class="text-lg font-bold text-gray-800 mb-2 flex flex-row-reverse items-center gap-3">
                <i class={`${benefit.icon} text-amber-500`} /> {benefit.title}
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed">{benefit.description}</p>
            </div>
          ))}
        </div>

        <div class="flex-1 w-full max-w-md order-1 lg:order-2 px-4">
          <div class="relative group">
            {/* Decoración: Ahora con giro más lento y estilo punteado */}
            <div class="absolute -inset-6 border border-dashed border-amber-400/30 rounded-full group-hover:rotate-180 transition-transform duration-4000 ease-linear"></div>
            
            <div class="relative h-105 md:h-145 rounded-full overflow-hidden border-10 border-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] isolate">
              <img 
                src="/images/beneficios/2.png" 
                alt="Beneficios Medicina Bioregenerativa" 
                class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out"
              />
              {/* Capa de luz para resaltar el dorado */}
              <div class="absolute inset-0 bg-linear-to-tr from-amber-500/5 via-transparent to-white/10"></div>
            </div>

            {/* Un pequeño elemento flotante extra opcional */}
            <div class="absolute -bottom-4 -right-4 bg-white p-4 rounded-2xl shadow-lg border border-amber-100 hidden md:block">
              <i class="fas fa-shield-alt text-amber-500 text-xl"></i>
            </div>
          </div>
        </div>

        {/* Columna Derecha: Últimos 3 beneficios */}
        <div class="flex-1 grid grid-cols-1 gap-6 w-full order-3">
          {benefits.slice(3, 6).map((benefit, index) => (
            <div class="p-6 border-l-[3px] border-amber-500 bg-white shadow-sm hover:shadow-md transition-shadow text-left" data-aos="fade-up" data-aos-delay={index * 100 + 200}>
              <div class="text-5xl font-bold text-amber-500 opacity-20 mb-2">{benefit.number}</div>
              <h3 class="text-lg font-bold text-gray-800 mb-2 flex items-center gap-3">
                <i class={`${benefit.icon} text-amber-500`} /> {benefit.title}
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed">{benefit.description}</p>
            </div>
          ))}
        </div>

      </div>

    </div>
  </section>

  <!-- Comparison Section -->
  <section id="comparativa" class="py-25 bg-white" data-aos="fade-up">
  <div class="max-w-350 mx-auto px-5">
    <div class="text-center mb-15" data-aos="fade-up" data-aos-delay="200">
       <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-balance-scale-right mr-2"></i> El Valor Dharma
      </span>
      <h2 class="text-4xl md:text-5xl font-serif text-slate-900 mb-4">La Diferencia es el Enfoque</h2>
         <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
        <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg font-light">
        Comparamos la medicina convencional de síntomas frente a nuestra metodología de restauración celular y epigenética.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch" data-aos="fade-up" data-aos-delay="400">
      
      <div class="relative p-1 rounded-4xl bg-linear-to-br from-amber-400 to-amber-600 shadow-2xl shadow-amber-900/10 transition-transform hover:-translate-y-1" data-aos="fade-up" data-aos-delay="200">
        <div class="bg-white p-8 md:p-10 rounded-[calc(2.5rem-4px)] h-full">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600">
              <i class="fas fa-dna text-xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 uppercase tracking-tight">En Dharma</h3>
          </div>
          
          <ul class="space-y-6">
            <li class="flex gap-4 items-start group">
              <span class="mt-1 shrink-0 w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xs">
                <i class="fas fa-check"></i>
              </span>
              <div>
                <strong class="block text-slate-900 mb-1">Análisis Epigenético Capilar</strong>
                <span class="text-slate-600 text-sm leading-relaxed">Evaluamos cómo tu entorno y nutrición afectan tus genes antes de iniciar cualquier tratamiento.</span>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <span class="mt-1 shrink-0 w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xs">
                <i class="fas fa-check"></i>
              </span>
              <div>
                <strong class="block text-slate-900 mb-1">Terapias Autólogas Naturales</strong>
                <span class="text-slate-600 text-sm leading-relaxed">Usamos tus propios recursos biológicos (Células Madre, PRP) potenciados con Ozonoterapia y Medicina Ortomolecular.</span>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <span class="mt-1 shrink-0 w-6 h-6 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xs">
                <i class="fas fa-check"></i>
              </span>
              <div>
                <strong class="block text-slate-900 mb-1">Especialista Liderando tu Caso</strong>
