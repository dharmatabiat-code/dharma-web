---
import Layout from "../layouts/Layout.astro";
import { company } from "../data/company";
import { services, benefits } from "../data/services";
import { testimonials } from "../data/testimonials";

// Get first 3 testimonials for display
const displayTestimonials = testimonials.slice(0, 3);
---

<Layout>
  <!-- Hero Section -->
  <section
    id="inicio"
    class="min-h-[calc(100vh-80px)] md:min-h-screen flex items-center justify-center relative bg-linear-to-br from-gray-50 via-white to-amber-50 overflow-hidden pt-20 md:pt-20"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/fondo.jpg"
        alt="Laboratorio Bioregenerativo"
        class="w-full h-full object-cover opacity-30 mix-blend-overlay scale-105 animate-slow-zoom"
      />
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_80%,rgba(212,165,42,0.15)_0%,transparent_50%),radial-gradient(ellipse_at_80%_20%,rgba(212,165,42,0.1)_0%,transparent_50%),radial-gradient(ellipse_at_50%_50%,rgba(212,165,42,0.05)_0%,transparent_70%)]"
    >
    </div>
    <div class="absolute inset-0 bg-pattern"></div>
    <div class="relative z-10 text-center px-4 md:px-5 animate-fade-in-up">
      <h2 class="text-2xl md:text-4xl font-light text-gray-800 mb-4 md:mb-5 tracking-wide md:tracking-wider">
        <i class="fas fa-dna text-amber-400 mr-1.5 md:mr-2.5"></i> <span class="md:hidden">Medicina Bioregenerativa</span><span class="hidden md:inline">Medicina Bioregenerativa</span>
      </h2>
      <p class="text-gray-600 max-w-xl mx-auto mb-8 md:mb-10 text-base md:text-lg leading-relaxed">
        Restaurando tu salud desde la raíz, con tecnología de vanguardia y un
        enfoque integral
      </p>
      <div class="mb-12 md:mb-15">
        <a
          href="#servicios"
          class="bg-linear-to-r from-amber-500 to-amber-600 text-white font-semibold px-6 py-3 md:px-8 md:py-4 rounded-full transition-all duration-300 hover:from-amber-400 hover:to-amber-500 hover:-translate-y-0.5 hover:shadow-xl inline-flex items-center gap-2 text-sm md:text-base"
        >
          <i class="fas fa-arrow-right"></i>
          <span>Descubre Nuestros Tratamientos</span>
        </a>
      </div>
    </div>
    <div
      class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 animate-bounce-custom"
    >
      <span class="text-2xl md:text-3xl text-amber-400"
        ><i class="fas fa-chevron-down"></i></span
      >
    </div>
  </section>

  <!-- About Section -->
  <section id="acerca" class="py-25 bg-white">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-star mr-2"></i> Sobre Dharma</span
        >
        <h2 class="text-4xl font-bold text-gray-800 mb-2.5">
          Medicina del Futuro, Hoy
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-15 items-center">
        <div class="about-text order-2 md:order-1">
          <p class="text-gray-600 text-lg leading-relaxed mb-5">
            En <strong class="text-amber-400">Dharma</strong>, somos líderes en
            medicina bioregenerativa, una disciplina revolucionaria que utiliza
            las propias capacidades de curación de tu cuerpo para restaurar
            tejidos, órganos y funciones deterioradas por el tiempo o
            enfermedad.
          </p>
          <p class="text-gray-600 text-lg leading-relaxed mb-7.5">
            Nuestro enfoque combina la más avanzada tecnología médica con
            tratamientos naturales potenciados, estimulando las células madre y
            factores de crecimiento propios del paciente para lograr resultados
            extraordinarios sin procedimientos invasivos.
          </p>
          <div class="flex flex-wrap gap-5">
            <div class="flex items-center gap-4 text-gray-800">
              <span
                class="w-10 h-10 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400"
                ><i class="fas fa-gem"></i></span
              >
              <span>Tratamientos Personalizados</span>
            </div>
            <div class="flex items-center gap-4 text-gray-800">
              <span
                class="w-10 h-10 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400"
                ><i class="fas fa-microscope"></i></span
              >
              <span>Tecnología de Última Generación</span>
            </div>
            <div class="flex items-center gap-4 text-gray-800">
              <span
                class="w-10 h-10 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400"
                ><i class="fas fa-leaf"></i></span
              >
              <span>Enfoque Integral y Natural</span>
            </div>
          </div>
        </div>
        <div class="flex justify-center items-center order-1 md:order-2">
          <div
            class="h-100 w-full aspect-square bg-linear-to-br from-gray-50 to-amber-100 rounded-[20px] flex flex-col items-center justify-center gap-5 border border-amber-400/30"
          >
            <img
              src="/MEDIC.jpg"
              alt="Laboratorio Bioregenerativo"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-25 bg-gray-100">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-hand-holding-medical mr-2"></i> Nuestros Servicios</span
        >
        <h2 class="text-4xl font-bold text-gray-800 mb-2.5">
          Tratamientos Bioregenerativos
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
        <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg">
          Ofrecemos una gama completa de tratamientos diseñados para restaurar
          tu vitalidad desde el nivel celular y juventud
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7.5">
        {
          services.map((service) => (
            <div class="bg-white border border-amber-200/20 rounded-2xl p-6 md:p-8 transition-all duration-300 hover:border-amber-500 hover:-translate-y-1 hover:shadow-xl text-center">
              <div class="w-20 h-20 bg-amber-400/10 rounded-full flex items-center justify-center text-amber-400 mx-auto mb-5">
                <i class={service.icon + " text-4xl"} />
              </div>
              <h3 class="text-xl text-gray-800 mb-4">{service.title}</h3>
              <p class="text-gray-500 mb-5 leading-relaxed">
                {service.description}
              </p>
              <ul class="text-left list-none p-0">
                {service.features.map((feature, index) => (
                  <li
                    class={`py-2 border-b border-amber-200/10 text-gray-500 text-sm flex items-center gap-2.5 ${index === service.features.length - 1 ? "border-0" : ""}`}
                  >
                    <i class="fas fa-star text-amber-500 text-xs" /> {feature}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section id="beneficios" class="py-25 bg-white">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-award mr-2"></i> ¿Por Qué Elegirnos?</span
        >
        <h2 class="text-4xl font-bold text-gray-800 mb-2.5">
          Beneficios de la Medicina Bioregenerativa
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7.5">
        {
          benefits.map((benefit) => (
            <div class="p-6 md:p-8 border-l-[3px] border-amber-500 bg-gray-50 shadow-sm">
              <div class="text-6xl font-bold text-amber-500 opacity-30 mb-4">
                {benefit.number}
              </div>
              <h3 class="text-xl text-gray-800 mb-4 flex items-center gap-2.5">
                <i class={`${benefit.icon} text-amber-400`} /> {benefit.title}
              </h3>
              <p class="text-gray-500 leading-relaxed">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-15 bg-linear-to-r from-amber-800 to-amber-600">
    <div class="max-w-350 mx-auto px-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-7.5 text-center">
        <div class="p-5">
          <div class="text-5xl text-white mb-2.5">
            <i class="fas fa-users"></i>
          </div>
          <div class="text-5xl font-bold text-white mb-2.5">
            {company.stats.patients}
          </div>
          <div class="text-white opacity-80">Pacientes Tratados</div>
        </div>
        <div class="p-5">
          <div class="text-5xl text-white mb-2.5">
            <i class="fas fa-calendar-check"></i>
          </div>
          <div class="text-5xl font-bold text-white mb-2.5">
            {company.stats.years}
          </div>
          <div class="text-white opacity-80">Años de Experiencia</div>
        </div>
        <div class="p-5">
          <div class="text-5xl text-white mb-2.5">
            <i class="fas fa-star"></i>
          </div>
          <div class="text-5xl font-bold text-white mb-2.5">
            {company.stats.satisfaction}
          </div>
          <div class="text-white opacity-80">Satisfacción</div>
        </div>
        <div class="p-5">
          <div class="text-5xl text-white mb-2.5">
            <i class="fas fa-spa"></i>
          </div>
          <div class="text-5xl font-bold text-white mb-2.5">
            {company.stats.treatments}
          </div>
          <div class="text-white opacity-80">Tratamientos Disponibles</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
<section id="testimonios" class="py-25 bg-linear-to-br from-gray-50 via-white to-amber-50/30 relative overflow-hidden">
  
  <!-- Decorative elements -->
  <div class="absolute top-10 left-10 w-40 h-40 bg-amber-400/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-10 right-10 w-60 h-60 bg-amber-400/10 rounded-full blur-3xl"></div>

  <div class="max-w-4xl mx-auto px-5 relative z-10">

    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5">
        <i class="fas fa-quote-left mr-2"></i> Testimonios
      </span>

      <h2 class="text-4xl font-bold text-gray-800 mb-2.5">
        Lo Que Dicen Nuestros Pacientes
      </h2>

      <div class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"></div>
    </div>

    <!-- Auto Carousel Container -->
    <div class="relative overflow-hidden">
      <div class="testimonial-slider flex transition-transform duration-700 ease-in-out">
        {
          testimonials.map((testimonial) => (
            <div class="w-full shrink-0 px-4">
              <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-8 md:p-10 shadow-xl border border-amber-200/30 max-w-2xl mx-auto">
                <!-- Rating -->
                <div class="flex justify-center mb-6">
                  <div class="flex gap-1">
                    {Array.from({ length: testimonial.rating }).map((_, i) => (
                      <i class="fas fa-star text-amber-400 text-lg"></i>
                    ))}
                  </div>
                </div>

                <!-- Comment -->
                <blockquote class="text-center mb-8">
                  <p class="text-gray-600 text-lg md:text-xl leading-relaxed italic">
                    "{testimonial.comment}"
                  </p>
                </blockquote>

                <!-- Author -->
                <div class="flex items-center justify-center gap-4 border-t border-amber-200/30 pt-6">
                  <div class="w-14 h-14 bg-linear-to-br from-amber-400 to-amber-600 rounded-full flex items-center justify-center text-white text-2xl shadow-lg">
                    <i class="fas fa-user"></i>
                  </div>
                  <div class="text-left">
                    <span class="block text-gray-800 font-bold text-lg">
                      {testimonial.name}
                    </span>
                    <span class="text-amber-600 text-sm font-medium">
                      {testimonial.treatment}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Dots Indicators -->
      <div class="flex justify-center gap-3 mt-8" id="testimonial-dots">
        {
          testimonials.map((_, index) => (
            <button
              class="testimonial-dot w-3 h-3 rounded-full bg-amber-200 transition-all duration-300"
              data-index={index}
              aria-label={`Ver testimonio ${index + 1}`}
            ></button>
          ))
        }
      </div>
    </div>
  </div>
</section>

  <!-- Contact Section -->
  <section id="contacto" class="py-25 bg-white">
    <div class="max-w-350 mx-auto px-5">
      <div class="text-center mb-15">
        <span
          class="inline-block bg-linear-to-r from-amber-700 to-amber-500 text-white px-5 py-2 rounded-full text-sm font-semibold tracking-wider uppercase mb-5"
          ><i class="fas fa-paper-plane mr-2"></i> Contáctanos</span
        >
        <h2 class="text-4xl font-bold text-gray-800 mb-2.5">
          Comienza Tu Transformación
        </h2>
        <div
          class="h-0.75 w-20 bg-linear-to-r from-amber-500 via-amber-300 to-amber-500 mx-auto"
        >
        </div>
        <p class="text-gray-500 max-w-150 mx-auto mt-5 text-lg">
          Agenda tu consulta gratuita y descubre cómo la medicina
          bioregenerativa puede transformar tu vida
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-15">
        <div class="contact-info">
          <div class="flex gap-5 mb-8">
            <div
              class="w-15 h-15 bg-amber-400/10 rounded-xl flex items-center justify-center text-amber-400 shrink-0"
            >
              <i class="fas fa-map-marker-alt text-2xl"></i>
            </div>
            <div>
              <h4 class="text-amber-400 text-lg mb-2 flex items-center gap-2">
                <i class="fas fa-location-dot"></i> Ubicación
              </h4>
              <p class="text-gray-500 leading-relaxed">
                {company.address.street}, {company.address.colony}<br />{
                  company.address.city
                }, {company.address.state}
              </p>
            </div>
          </div>

          <div class="flex gap-5 mb-8">
            <div
              class="w-15 h-15 bg-amber-400/10 rounded-xl flex items-center justify-center text-amber-400 shrink-0"
            >
              <i class="fas fa-phone-alt text-2xl"></i>
            </div>
            <div>
              <h4 class="text-amber-400 text-lg mb-2 flex items-center gap-2">
                <i class="fas fa-phone"></i> Teléfono
              </h4>
              <p class="text-gray-500">{company.contact.phone}</p>
            </div>
          </div>

          <div class="flex gap-5 mb-8">
            <div
              class="w-15 h-15 bg-amber-400/10 rounded-xl flex items-center justify-center text-amber-400 shrink-0"
            >
              <i class="fas fa-envelope text-2xl"></i>
            </div>
            <div>
              <h4 class="text-amber-400 text-lg mb-2 flex items-center gap-2">
                <i class="fas fa-paper-plane"></i> Email
              </h4>
              <p class="text-gray-500">{company.contact.email}</p>
            </div>
          </div>

          <div class="flex gap-5">
            <div
              class="w-15 h-15 bg-amber-400/10 rounded-xl flex items-center justify-center text-amber-400 shrink-0"
            >
              <i class="fas fa-clock text-2xl"></i>
            </div>
            <div>
              <h4 class="text-amber-400 text-lg mb-2 flex items-center gap-2">
                <i class="fas fa-hourglass-half"></i> Horario
              </h4>
              <p class="text-gray-500 leading-relaxed">
                {company.hours.monday}<br />{company.hours.sunday}
              </p>
            </div>
          </div>
        </div>

        <div
          class="bg-white p-10 rounded-2xl border border-amber-200/20 shadow-sm"
        >
          <form class="contact-form">
            <div class="mb-5 relative">
              <i
                class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 z-10"
              ></i>
              <input
                type="text"
                class="w-full bg-gray-50 border border-amber-400/30 text-gray-800 py-3.5 px-11 rounded-lg transition-all duration-300 focus:outline-none focus:border-amber-500 focus:shadow-[0_0_0_3px_rgba(212,165,42,0.1)]"
                placeholder="Nombre Completo"
                required
              />
            </div>
            <div class="mb-5 relative">
              <i
                class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 z-10"
              ></i>
              <input
                type="email"
                class="w-full bg-gray-50 border border-amber-400/30 text-gray-800 py-3.5 px-11 rounded-lg transition-all duration-300 focus:outline-none focus:border-amber-500 focus:shadow-[0_0_0_3px_rgba(212,165,42,0.1)]"
                placeholder="Correo Electrónico"
                required
              />
            </div>
            <div class="mb-5 relative">
              <i
                class="fas fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 z-10"
              ></i>
              <input
                type="tel"
                class="w-full bg-gray-50 border border-amber-400/30 text-gray-800 py-3.5 px-11 rounded-lg transition-all duration-300 focus:outline-none focus:border-amber-500 focus:shadow-[0_0_0_3px_rgba(212,165,42,0.1)]"
                placeholder="Teléfono"
              />
            </div>
            <div class="mb-5 relative">
              <i
                class="fas fa-clipboard-list absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 z-10"
              ></i>
              <select class="select-gold">
                <option value="">Selecciona un tratamiento de interés</option>
                <option value="celulas-madre">Terapia con Células Madre</option>
                <option value="prp">Plasma Rico en Plaquetas</option>
                <option value="estetico">Tratamientos Estéticos</option>
                <option value="antiaging">Medicina Antiaging</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="mb-5 relative">
              <i class="fas fa-comment absolute left-4 top-5 text-gray-500 z-10"
              ></i>
              <textarea
                class="w-full bg-gray-50 border border-amber-400/30 text-gray-800 py-3.5 px-11 rounded-lg transition-all duration-300 focus:outline-none focus:border-amber-500 focus:shadow-[0_0_0_3px_rgba(212,165,42,0.1)]"
                rows="4"
                placeholder="Cuéntanos sobre tus objetivos de salud..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-linear-to-r from-amber-500 to-amber-600 text-white font-semibold py-4 rounded-lg transition-all duration-300 hover:from-amber-400 hover:to-amber-500 hover:-translate-y-0.5 hover:shadow-lg flex items-center justify-center gap-2.5"
            >
              <i class="fas fa-paper-plane"></i>
              <span>Enviar Mensaje</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Testimonial Auto Slider Styles */
  .testimonial-slider {
    overflow: visible;
  }

  .testimonial-slider > div {
    opacity: 0.4;
    transform: scale(0.95);
    transition: all 0.5s ease;
  }

  .testimonial-slider > div.active {
    opacity: 1;
    transform: scale(1);
  }

  .testimonial-dot {
    width: 12px;
    height: 12px;
  }

  .testimonial-dot.active {
    background-color: #d4a52a;
    width: 40px;
    border-radius: 9999px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .grid-cols-3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile Landscape */
  @media (max-width: 768px) {
    .grid-cols-2 {
      grid-template-columns: 1fr;
    }

    .grid-cols-3 {
      grid-template-columns: 1fr;
    }

    .grid-cols-4 {
      grid-template-columns: 1fr;
    }

    .about-text {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile Portrait */
  @media (max-width: 480px) {
    h2 {
      font-size: 1.75rem !important;
    }
    
    p {
      font-size: 1rem !important;
    }
    
    .text-4xl {
      font-size: 1.75rem !important;
    }
    
    .text-lg {
      font-size: 1rem !important;
    }
    
    .py-25 {
      padding-top: 3rem !important;
      padding-bottom: 3rem !important;
    }
    
    .py-15 {
      padding-top: 2.5rem !important;
      padding-bottom: 2.5rem !important;
    }
    
    .gap-15 {
      gap: 2rem !important;
    }
    
    .gap-7\.5 {
      gap: 1.5rem !important;
    }
    
    .min-h-screen {
      min-height: auto !important;
      padding-top: 5rem !important;
      padding-bottom: 3rem !important;
    }
    
    .h-100 {
      height: 20rem !important;
    }
    
    .p-8 {
      padding: 1.25rem !important;
    }
    
    .p-10 {
      padding: 1.25rem !important;
    }
    
    .grid-cols-4 > div {
      padding: 1rem !important;
    }
    
    .grid-cols-4 > div .text-5xl {
      font-size: 2rem !important;
    }
  }
</style>

<script>
  // Testimonial Auto Slider Functionality
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.querySelector('.testimonial-slider') as HTMLElement;
    const slides = document.querySelectorAll('.testimonial-slider > div');
    const dots = document.querySelectorAll('.testimonial-dot');
    
    if (!slider || slides.length === 0) return;
    
    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayInterval: ReturnType<typeof setInterval>;
    
    // Initialize
    updateSlider(0);
    startAutoPlay();
    
    function updateSlider(index: number) {
      // Move slider
      if (slider) {
        slider.style.transform = `translateX(-${index * 100}%)`;
      }
      
      // Update active states
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
      
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });
      
      currentIndex = index;
    }
    
    function nextSlide() {
      const newIndex = (currentIndex + 1) % totalSlides;
      updateSlider(newIndex);
    }
    
    function startAutoPlay() {
      autoPlayInterval = setInterval(nextSlide, 5000);
    }
    
    function stopAutoPlay() {
      clearInterval(autoPlayInterval);
    }
    
    // Dot navigation
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        updateSlider(index);
        startAutoPlay();
      });
    });
    
    // Pause on hover
    const container = slider.parentElement;
    if (container) {
      container.addEventListener('mouseenter', stopAutoPlay);
      container.addEventListener('mouseleave', startAutoPlay);
    }
    
    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    
    slider.addEventListener('touchstart', (e: Event) => {
      const touchEvent = e as TouchEvent;
      touchStartX = touchEvent.changedTouches[0].screenX;
    }, { passive: true });
    
    slider.addEventListener('touchend', (e: Event) => {
      const touchEvent = e as TouchEvent;
      touchEndX = touchEvent.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });
    
    function handleSwipe() {
      const diff = touchStartX - touchEndX;
      const threshold = 50;
      
      if (Math.abs(diff) > threshold) {
        stopAutoPlay();
        if (diff > 0) {
          nextSlide();
        } else {
          const newIndex = (currentIndex - 1 + totalSlides) % totalSlides;
          updateSlider(newIndex);
        }
        startAutoPlay();
      }
    }
  });
</script>
